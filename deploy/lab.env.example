# /etc/lab/lab.env  (mode 640 root:lab) — Labradoor gateway settings
LAB_HOST=0.0.0.0
LAB_PORT=8100
# the address people open in the browser (behind your reverse proxy)
LAB_PUBLIC_URL=https://labradoor.example.com
LAB_BRAND=labradoor
LAB_DB=/var/lib/lab/lab.sqlite3
LAB_STATIC=/opt/lab/ui/dist
LAB_MODULES=/opt/lab/modules
LAB_KEYS=/etc/lab/keys
LAB_TOPOLOGY=/etc/lab/topology.json
# 1 = replace /etc/lab/topology.json from the release on every install (only for a topology kept in your own repo)
LAB_TOPOLOGY_UPDATE=0
LAB_COOKIE_SECURE=1
LAB_TRUST_PROXY=1
# only these peers may set X-Real-IP / X-Forwarded-For (your reverse proxy); everyone else is logged by socket address.
# Loopback (a proxy in this container) counts only with LAB_PROXY_SECRET (sent by the proxy as X-Lab-Proxy-Secret):
# connectors run here too and must not pick client addresses
LAB_TRUSTED_PROXIES=
# LAB_PROXY_SECRET=
# who may read /metrics (add your monitoring server)
LAB_METRICS_ALLOW=127.0.0.1

# Login (docs/login.md). The first run prints a one-time link to create the owner; local accounts, 2FA, single sign-on
# (OpenID Connect: Authentik, Keycloak, …) and session lengths are then set in Settings → Login. A value set HERE wins
# over Settings and shows there as locked — leave these empty to manage them in the UI.
LAB_OIDC_ISSUER=
LAB_OIDC_NAME=
LAB_OIDC_CLIENT_ID=
LAB_OIDC_CLIENT_SECRET=
# SSO groups that make owner / admin (default lab-owners / lab-admins)
LAB_OWNER_GROUP=
LAB_ADMIN_GROUP=
# LAB_REQUIRE_2FA=1  LAB_SESSION_DAYS=14  LAB_LOCAL_SESSION_DAYS=14  LAB_SSO_MAX_AGE_HOURS=24

# mail to the owner when an admin asks for an approval (optional)
LAB_SMTP_HOST=
LAB_SMTP_PORT=587
LAB_SMTP_USER=
LAB_SMTP_PASSWORD=
LAB_SMTP_FROM=
LAB_OWNER_EMAIL=
