#!/usr/bin/env python3
"""Root helper for Labradoor connectors (installed as /usr/local/sbin/lab-connector-helper).

Socket-activated (lab-connector-helper.socket, Accept=yes): one process per request, ONE JSON line in on stdin, ONE JSON line
out. Only group lab (the gateway) can connect. The gateway never needs root: this is the only privileged part, and it
handles no secrets — it never sees a connector's config (the connector fetches that from the gateway itself).

  {"op": "ensure",  "id": ID}   user + key + enable + start (if not running)
  {"op": "restart", "id": ID}   user + key + enable + restart (the owner saved new config)
  {"op": "stop",    "id": ID}   disable + stop (the module was switched off)
  {"op": "status"}              {"connectors": {id: state}} for every connector shipped in CONNECTORS_DIR

ID must be a connector shipped with the release (CONNECTORS_DIR/<id>/connector.py, root-owned) or the connector of a
module installed from a catalog (INSTALLED_DIR/<id>/<version>/connector/connector.py, root-owned, put there by
lab-module-helper; a unit drop-in then points lab-connector@<id> at it). For it this helper
  * creates the unix user lab-c-<id> (system, no login, no home, NOT in group lab) if missing;
  * creates its HMAC key KEYS_DIR/<id>.key (root:lab 0640) if missing — systemd hands the connector a private copy
    (LoadCredential); the connector itself can't read KEYS_DIR;
  * runs systemctl on lab-connector@<id> — nothing else.

A bundled connector with a dependency (today only `ai`: the Claude SDK) ships connectors/<id>/requirements.txt, hash
locked, inside the signed release tree. Its unit drop-in (install.sh) runs, as root, before every start:

  lab-connector-helper venv ID

which (re)builds VENV_DIR/<id> only when that file changed (a stamp holds its sha256 + the Python version), so a
venv is made when the connector is first turned on or its pins change — never at core install, and never with an
unpinned resolve. The build itself runs as the unprivileged user lab-venv-build:
`python3 -m venv` + `pip install --require-hashes --only-binary :all: --no-deps -r requirements.txt` (wheels only:
no build script runs; every file is checked against the release's hashes). Then root takes the tree over (no link
followed), stamps it and swaps it in. Security review 2026-11-15, L9."""
import json
import os
import re
import secrets
import subprocess
import sys

CONNECTORS_DIR = os.environ.get("LAB_CONNECTORS_DIR", "/opt/lab/connectors")
INSTALLED_DIR = os.environ.get("LAB_INSTALLED_MODULES", "/var/lib/lab-modules")   # lab-module-helper's, root 0755
BUNDLED_DIR = os.environ.get("LAB_BUNDLED_MODULES", "/opt/lab/modules")
UNIT_DIR = os.environ.get("LAB_UNIT_DIR", "/etc/systemd/system")
KEYS_DIR = os.environ.get("LAB_KEYS", "/etc/lab/keys")
ID_RE = re.compile(r"^[a-z][a-z0-9-]{1,25}$")  # "lab-c-" + 26 = 32, the longest user name useradd takes
OPS = ("ensure", "restart", "stop", "status")
SYSTEMCTL = os.environ.get("LAB_SYSTEMCTL", "/usr/bin/systemctl")
VENV_DIR = os.environ.get("LAB_VENV_DIR", "/var/lib/lab-venvs")
BUILD_USER = os.environ.get("LAB_VENV_BUILD_USER", "lab-venv-build")
PYTHON = os.environ.get("LAB_VENV_PYTHON", "/usr/bin/python3")
STAMP = ".lab-requirements.sha256"
RETRY_AFTER = 60   # a failed build (no network) is not retried on every Restart=always tick


class Fail(Exception):
    pass


def unit(cid):
    return f"lab-connector@{cid}.service"


def user(cid):
    return f"lab-c-{cid}"


def _version_key(v):
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)(-.*)?$", v or "")
    return (int(m.group(1)), int(m.group(2)), int(m.group(3)), 0 if m.group(4) else 1) if m else None


def installed(cid):
    """The live version of an installed module whose package has a connector, if it is the one in use: no bundled module
    of that id, or the installed one is newer (the gateway's registry applies the same rule). Else None."""
    try:
        with open(os.path.join(INSTALLED_DIR, cid, "state.json"), encoding="utf-8") as f:
            v = json.load(f).get("version")
    except (OSError, ValueError, AttributeError):
        return None
    if not _version_key(v) or not os.path.isfile(os.path.join(INSTALLED_DIR, cid, v, "connector", "connector.py")):
        return None
    try:
        with open(os.path.join(BUNDLED_DIR, cid, "manifest.json"), encoding="utf-8") as f:
            bv = json.load(f).get("version")
        if _version_key(bv) and _version_key(bv) >= _version_key(v):
            return None
    except (OSError, ValueError, AttributeError):
        pass
    return v


def shipped():
    out = set()
    if os.path.isdir(CONNECTORS_DIR):
        out |= {d for d in os.listdir(CONNECTORS_DIR)
                if ID_RE.match(d) and os.path.isfile(os.path.join(CONNECTORS_DIR, d, "connector.py"))}
    if os.path.isdir(INSTALLED_DIR):
        out |= {d for d in os.listdir(INSTALLED_DIR) if ID_RE.match(d) and installed(d)}
    return sorted(out)


def dropin(cid):
    """lab-connector@<id> runs the installed package's connector (when that is the one in use), else the bundled one."""
    path = os.path.join(UNIT_DIR, f"lab-connector@{cid}.service.d", "50-module.conf")
    v = installed(cid)
    want = (f"# lab-module-helper: the connector of the installed module {cid} {v}\n[Service]\n"
            f"WorkingDirectory={INSTALLED_DIR}/{cid}/{v}/connector\n") if v else None
    try:
        with open(path, encoding="utf-8") as f:
            have = f.read()
    except OSError:
        have = None
    if have == want:
        return
    if want is None:
        os.unlink(path)
    else:
        os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
        with open(path + ".new", "w", encoding="utf-8") as f:
            f.write(want)
        os.chmod(path + ".new", 0o644)
        os.replace(path + ".new", path)
    run(SYSTEMCTL, "daemon-reload")


def check(req):
    """The request → (op, id). Everything not exactly as documented is refused."""
    if not isinstance(req, dict) or set(req) - {"op", "id"}:
        raise Fail("request is {op, id}")
    op = req.get("op")
    if op not in OPS:
        raise Fail(f"op is one of {OPS}")
    if op == "status":
        if "id" in req:
            raise Fail("status takes no id")
        return op, None
    cid = req.get("id")
    if not (isinstance(cid, str) and ID_RE.match(cid)):
        raise Fail("id: a connector id (a-z 0-9 -, 2–26 characters)")
    if cid not in shipped():
        raise Fail(f"no connector {cid} in this release")
    return op, cid


def run(*cmd):
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    if p.returncode:
        raise Fail(f"{' '.join(cmd[:2])} failed: {(p.stderr or p.stdout).strip()[:200]}")
    return p.stdout


def ensure_user(cid):
    import pwd
    name = user(cid)
    try:
        pwd.getpwnam(name)
    except KeyError:
        run("/usr/sbin/useradd", "--system", "--user-group", "--no-create-home", "--home-dir", "/nonexistent",
            "--shell", "/usr/sbin/nologin", "--comment", f"Labradoor connector {cid}", name)
    # a connector user is never in group lab (that group reads the keys dir and the master key)
    import grp
    try:
        if name in grp.getgrnam("lab").gr_mem:
            run("/usr/bin/gpasswd", "-d", name, "lab")
    except KeyError:
        pass


def ensure_key(cid):
    path = os.path.join(KEYS_DIR, f"{cid}.key")
    if os.path.exists(path):
        return
    import grp
    fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    with os.fdopen(fd, "w") as f:
        f.write(secrets.token_hex(32) + "\n")
    try:
        os.chown(path + ".new", 0, grp.getgrnam("lab").gr_gid)
    except KeyError:
        pass
    os.replace(path + ".new", path)


def state(cid):
    p = subprocess.run([SYSTEMCTL, "is-active", unit(cid)], capture_output=True, text=True, timeout=30)
    return p.stdout.strip() or "unknown"


def handle(req):
    op, cid = check(req)
    if op == "status":
        return {"connectors": {c: state(c) for c in shipped()}}
    if op == "stop":
        run(SYSTEMCTL, "disable", "--now", unit(cid))
        return {"state": state(cid)}
    ensure_user(cid)
    ensure_key(cid)
    dropin(cid)
    run(SYSTEMCTL, "enable", unit(cid))
    if op == "restart":
        run(SYSTEMCTL, "restart", unit(cid))
    elif state(cid) != "active":
        run(SYSTEMCTL, "start", unit(cid))
    return {"state": state(cid)}


# --- the venv of a connector with a requirements.txt ------------------------------------------------------------------
def _want(req):
    import hashlib
    with open(req, "rb") as f:
        data = f.read(1 << 20)
    ver = subprocess.run([PYTHON, "-c", "import sys; print('%d.%d' % sys.version_info[:2])"], capture_output=True,
                         text=True, timeout=30).stdout.strip()
    return hashlib.sha256(data + b"\0" + ver.encode()).hexdigest()


def _root_dir(path):
    if os.path.islink(path) or (os.path.exists(path) and not os.path.isdir(path)):
        raise Fail(f"{path} is not a directory")
    os.makedirs(path, mode=0o755, exist_ok=True)
    st = os.lstat(path)
    if os.geteuid() == 0 and (st.st_uid != 0 or st.st_mode & 0o022):
        os.chown(path, 0, 0, follow_symlinks=False)
        os.chmod(path, 0o755)


def _readable(tree):
    """Directories 0755, files 0644 (0755 when executable): the connector runs as ANOTHER user (lab-c-<id>), and the
    build ran under the unit's UMask=0077."""
    import stat
    for dirpath, dirnames, filenames in os.walk(tree, followlinks=False):
        os.chmod(dirpath, 0o755)
        for n in dirnames + filenames:
            p = os.path.join(dirpath, n)
            st = os.lstat(p)
            if stat.S_ISLNK(st.st_mode):
                continue
            os.chmod(p, 0o755 if stat.S_ISDIR(st.st_mode) or st.st_mode & 0o100 else 0o644)


def _take_over(tree):
    """Everything under tree → root:root; links are changed themselves, never followed."""
    os.lchown(tree, 0, 0)
    for dirpath, dirnames, filenames in os.walk(tree, followlinks=False):
        for n in dirnames + filenames:
            os.lchown(os.path.join(dirpath, n), 0, 0)


def _build_user():
    import pwd
    try:
        return pwd.getpwnam(BUILD_USER)
    except KeyError:
        run("/usr/sbin/useradd", "--system", "--user-group", "--no-create-home", "--home-dir", "/nonexistent",
            "--shell", "/usr/sbin/nologin", "--comment", "Labradoor connector venv builds", BUILD_USER)
        return pwd.getpwnam(BUILD_USER)


def venv(cid, log=print):
    """Make sure VENV_DIR/<cid> matches connectors/<cid>/requirements.txt. → "none" (no requirements), "current",
    or "built". Fail on any problem (the unit then does not start, and says why in its journal)."""
    import shutil
    if not (isinstance(cid, str) and ID_RE.match(cid)):
        raise Fail("id: a connector id")
    req = os.path.join(CONNECTORS_DIR, cid, "requirements.txt")
    if not os.path.isfile(req):
        return "none"
    want = _want(req)
    dest = os.path.join(VENV_DIR, cid)
    try:
        with open(os.path.join(dest, STAMP), encoding="ascii") as f:
            if f.read().strip() == want and not os.path.islink(dest):
                return "current"
    except OSError:
        pass
    _root_dir(VENV_DIR)
    failed = os.path.join(VENV_DIR, f".{cid}.failed")
    try:
        import time
        if time.time() - os.lstat(failed).st_mtime < RETRY_AFTER:
            raise Fail(f"the last venv build for {cid} failed less than {RETRY_AFTER} s ago (journalctl -u "
                       f"lab-connector@{cid}); trying again after that")
    except FileNotFoundError:
        pass
    root = os.geteuid() == 0
    pw = _build_user() if root else None          # tests (not root) build as themselves
    tmp = os.path.join(VENV_DIR, f".build-{cid}")
    shutil.rmtree(tmp, ignore_errors=True)            # root's tree: rmtree never follows a link
    os.mkdir(tmp, 0o700)
    shutil.copyfile(req, os.path.join(tmp, "requirements.txt"))
    os.chmod(os.path.join(tmp, "requirements.txt"), 0o644)
    if pw:
        os.chown(tmp, pw.pw_uid, pw.pw_gid)
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "HOME": tmp, "LANG": "C.UTF-8", "PIP_NO_CACHE_DIR": "1",
           "PIP_DISABLE_PIP_VERSION_CHECK": "1", "PIP_NO_INPUT": "1"}
    as_builder = {"env": env, "cwd": tmp, "umask": 0o022}
    if pw:
        as_builder.update(user=pw.pw_uid, group=pw.pw_gid, extra_groups=[])
    try:
        if subprocess.run([PYTHON, "-c", "import ensurepip"], capture_output=True, timeout=30).returncode:
            if not root:
                raise Fail("python3-venv is missing (apt-get install python3-venv)")
            log("python3-venv missing: apt-get install python3-venv")
            p = subprocess.run(["/usr/bin/apt-get", "install", "-y", "-q", "python3-venv"], capture_output=True,
                               text=True, timeout=600, env={**env, "HOME": "/root", "DEBIAN_FRONTEND": "noninteractive"})
            if p.returncode:
                raise Fail(f"apt-get install python3-venv failed: {(p.stderr or p.stdout).strip()[-300:]}")
        log(f"building the {cid} venv as {BUILD_USER} (hash-locked wheels from {req})")
        for cmd in ([PYTHON, "-m", "venv", os.path.join(tmp, "venv")],
                    [os.path.join(tmp, "venv", "bin", "python"), "-m", "pip", "install", "--require-hashes",
                     "--only-binary", ":all:", "--no-deps", "--no-input", "-q", "-r", os.path.join(tmp, "requirements.txt")]):
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=600, **as_builder)
            if p.returncode:
                raise Fail(f"{os.path.basename(cmd[0])} {' '.join(cmd[1:3])} failed: {(p.stderr or p.stdout).strip()[-400:]}")
        if pw:
            subprocess.run(["/usr/bin/pkill", "-KILL", "-u", BUILD_USER], capture_output=True, timeout=30)
        new = os.path.join(tmp, "venv")
        if os.path.islink(new) or not os.path.isdir(new):
            raise Fail("the build left no venv")
        if root:
            _take_over(tmp)
        _readable(new)
        with open(os.path.join(new, STAMP), "w", encoding="ascii") as f:
            f.write(want + "\n")
        os.chmod(os.path.join(new, STAMP), 0o644)
        old = os.path.join(VENV_DIR, f".old-{cid}")
        shutil.rmtree(old, ignore_errors=True)
        if os.path.lexists(dest):
            os.rename(dest, old)
        os.rename(new, dest)
        shutil.rmtree(old, ignore_errors=True)
        if os.path.lexists(failed):
            os.unlink(failed)
        return "built"
    except BaseException:
        with open(failed, "w") as f:
            f.write("failed\n")
        raise
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    if sys.argv[1:2] == ["venv"]:   # ExecStartPre=+ of a connector with requirements.txt (root, before every start)
        try:
            out = venv(sys.argv[2] if len(sys.argv) == 3 else "", log=lambda m: print(f"lab-connector-helper: {m}",
                                                                                     file=sys.stderr))
            print(f"lab-connector-helper: venv {sys.argv[2]}: {out}", file=sys.stderr)
            sys.exit(0)
        except (Fail, OSError, subprocess.SubprocessError) as e:
            print(f"lab-connector-helper: venv: {e}", file=sys.stderr)
            sys.exit(1)
    line = b""
    try:
        line = sys.stdin.buffer.readline(4096)
        out = {"ok": True, **handle(json.loads(line.decode() or "null"))}
    except Fail as e:
        out = {"ok": False, "error": str(e)}
    except (ValueError, UnicodeDecodeError, TypeError):
        out = {"ok": False, "error": "one JSON line expected"}
    except Exception as e:  # noqa: BLE001
        out = {"ok": False, "error": f"helper error: {e.__class__.__name__}"}
    try:
        sys.stdout.write(json.dumps(out) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:  # the caller hung up (a timeout, or a probe that only connected)
        pass
    print(f"lab-connector-helper: {line[:200]!r} -> {out}", file=sys.stderr)


if __name__ == "__main__":
    main()
